@page
@{
    ViewData["Title"] = "SQL BPA Recommendations";
}

<h2 class="mb-3">SQL Best Practice Assessment Recommendations</h2>

<div id="loadingIndicator" class="text-muted mb-2">
    Loading BPA results…
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Server</label>
        <select id="serverFilter" class="form-select">
            <option value="">All Servers</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Severity</label>

    <select id="severityFilter" class="form-select" multiple size="4">
        <option value="">All Severities</option>
        <option value="High">High</option>
        <option value="Medium">Medium</option>
        <option value="Low">Low</option>
    </select>

        <small class="text-muted">Hold Ctrl / Cmd to select multiple</small>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-secondary me-2" onclick="exportCsv()">Export CSV</button>
        <button class="btn btn-outline-secondary" onclick="clearCache()">Clear Cache</button>
    </div>
</div>

<div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
    <table class="table table-bordered table-striped table-sm" id="bpaTable">
        <thead class="table-dark sticky-top">
            <tr>
                <th>Server</th>
                <th>Last BPA Run</th>
                <th>Source</th>
                <th>Severity</th>
                <th>Rule ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>AdditionalDetails</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<style>
    /* ✅ Make Description comfortable to read */
    td.description-cell {
        min-width: 400px;
        white-space: normal;
        word-break: break-word;
    }

    /* ✅ Keep AdditionalDetails compact */
    td.details-cell {
        max-width: 260px;
        white-space: normal;
        word-break: break-word;
        font-size: 0.9em;
        color: #555;
    }
</style>

<script>
const CACHE_KEY = "bpa_latest_cache_v1";
const CACHE_TTL_MINUTES = 15;

let allData = [];
function severityBadge(sev) {
    if (sev === "High") return '<span class="badge bg-danger">High</span>';
    if (sev === "Medium") return '<span class="badge bg-warning text-dark">Medium</span>';
    if (sev === "Low") return '<span class="badge bg-success">Low</span>';
    return escapeHtml(sev);
}
document.addEventListener("DOMContentLoaded", async () => {
    const cached = getCache();
    if (cached) {
        allData = cached;
        initializeFilters();
        renderTable();
    } else {
        await loadData();
    }

    document.getElementById("serverFilter").addEventListener("change", renderTable);
    document.getElementById("severityFilter").addEventListener("change", renderTable);
});

async function loadData() {
    document.getElementById("loadingIndicator").style.display = "block";

    const response = await fetch(`/api/bpa/recommendations?cb=${Date.now()}`, {
        headers: { "Cache-Control": "no-store" }
    });

    allData = await response.json();

    document.getElementById("loadingIndicator").style.display = "none";

    setCache(allData);
    initializeFilters();
    renderTable();
}

function initializeFilters() {
    const serverSelect = document.getElementById("serverFilter");
    serverSelect.innerHTML = '<option value="">All Servers</option>';

    [...new Set(allData.map(r => r.serverName))]
        .sort()
        .forEach(server => {
            const opt = document.createElement("option");
            opt.value = server;
            opt.textContent = server;
            serverSelect.appendChild(opt);
        });

    document.getElementById("severityFilter").selectedIndex = -1;
}

function renderTable() {
    document.getElementById("loadingIndicator").style.display = "none";
    const tbody = document.querySelector("#bpaTable tbody");
    tbody.innerHTML = "";

    const server = document.getElementById("serverFilter").value;
    const severitySelect = document.getElementById("severityFilter");
    
const selectedSeverities = Array.from(severitySelect.selectedOptions)
    .map(o => o.value)
    .filter(v => v); // removes "" from "All Severities"


    const filtered = allData
        .filter(r => !server || r.serverName === server)
        .filter(r => selectedSeverities.length === 0 || selectedSeverities.includes(r.severity))
        .sort((a, b) => severityRank(b.severity) - severityRank(a.severity));

    for (const r of filtered) {
        const row = document.createElement("tr");
        row.innerHTML = `
            <td>${escapeHtml(r.serverName)}</td>
            <td>${r.lastRunDate ? new Date(r.lastRunDate).toLocaleString() : ""}</td>
            <td>${escapeHtml(r.source)}</td>
            <td>${severityBadge(r.severity)}</td>            
            <td>${escapeHtml(r.ruleId)}</td>
            <td>${escapeHtml(r.title)}</td>
            <td class="description-cell">
                ${escapeHtml(r.description)}
                ${r.helpLink && r.helpLink.trim()
                    ? ` <a href="${r.helpLink}" target="_blank" rel="noopener noreferrer">(Help)</a>`
                    : ""}
            </td>
            <td class="details-cell">${escapeHtml(r.additionalDetails ?? "")}</td>
        `;
        tbody.appendChild(row);
    }
}

function exportCsv() {
    const headers = ["ServerName","Severity","RuleId","Title","Description","HelpLink","AdditionalDetails"];
    const rows = allData.map(r => [
        r.serverName, r.severity, r.ruleId, r.title,
        r.description, r.helpLink ?? "", r.additionalDetails ?? ""
    ]);

    const csv = headers.join(",") + "\n" +
        rows.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(",")).join("\n");

    download("bpa_recommendations.csv", csv);
}

function download(filename, text) {
    const blob = new Blob([text], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
}

function severityRank(s) {
    return s === "High" ? 3 : s === "Medium" ? 2 : s === "Low" ? 1 : 0;
}

function escapeHtml(v) {
    return (v ?? "").toString().replace(/[&<>"']/g, c => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "\"": "&quot;",
        "'": "&#39;"
    }[c]));
}

function setCache(data) {
    localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), data }));
}

function getCache() {
    const raw = localStorage.getItem(CACHE_KEY);
    if (!raw) return null;

    const parsed = JSON.parse(raw);
    const ageMinutes = (Date.now() - parsed.timestamp) / 60000;
    if (ageMinutes > CACHE_TTL_MINUTES) {
        localStorage.removeItem(CACHE_KEY);
        return null;
    }
    return parsed.data;
}

function clearCache() {
    localStorage.removeItem(CACHE_KEY);
    location.reload();
}
</script>